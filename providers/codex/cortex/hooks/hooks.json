{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${PLUGIN_ROOT}/hooks/session-start.md\"",
            "additionalContextLimit": 2000,
            "timeout": 5,
            "statusMessage": "Loading Socra Cortex guidance"
          }
        ]
      }
    ]
  }
}
